// A single-axis belt-driven linear stage.
//
// Rewritten. The first version put the motor on the beam's side slot and the
// carriage on its top, which left the belt running down one face and the thing
// it drives sitting on another - 37.5 mm out of plane and 32.5 mm below it. The
// resolver reported 816 mm of belt and every number in it was arithmetically
// correct. Nothing was wrong except that the belt could not reach.
//
// So this one is built around the belt plane rather than around the parts, and
// fabrica now refuses a route whose clamped ends do not lie on its run.
//
// The frame is the extrusion's own: the beam runs along +z because that is the
// axis mechanica models it on, and fabrica grounds a part in the frame it
// arrives in. A stage has no opinion about gravity, so neither does this.
//
//   - the beam is 20 square centred on x and y, running z from 0 to its length
//   - the carriage rides the -x slot and hangs outboard, clear of the beam
//   - the belt runs alongside that face, in the plane x = -(10 + belt_offset),
//     its two straight runs at y = plus and minus the pulley's pitch radius
//   - both pulley axes are along x, which is across the beam, which is what the
//     L bracket exists to arrange
//
// The motor end is four parts and a hub. The flange turns the end of the
// extrusion into a bolt circle; the bracket takes a bolt circle on one leg and
// a NEMA frame on the other; neither has heard of the other. The idler end is
// the same flange and the same L, with a spindle where the motor face is - and
// it has to be the SAME L, because two pulleys that are not coplanar do not run
// a belt, and that is a mistake this machine has already made once.

@proven 1;
@machine "{travel} mm belt-driven linear stage on {profile}";

@parameter travel: length {
    label   = "Travel";
    aspect  = size;
    min     = 50;
    max     = 150;
    default = 100;
    summary = "How far the carriage moves, end to end";
    convention = "The usable stroke. The beam is longer by 150 - the carriage's own length, and the clearance at each end that keeps it off the flanges.";
    limits  = "Capped at 150 because mechanica models extrusion only to 300 mm and the beam is travel plus 150. Stock is sold by the metre, so this is a limit of the model rather than of the thing.";
}

@parameter profile: standard {
    label   = "Rail";
    aspect  = form;
    family  = t_slot_extrusion;
    default = "2020";
    summary = "The extrusion the carriage rides on";
}

@parameter frame: standard {
    label   = "Motor";
    aspect  = form;
    family  = nema_frame;
    default = "17";
    summary = "The stepper driving the belt";
}

@parameter belt_profile: standard {
    label   = "Belt";
    aspect  = form;
    family  = belt_profile;
    default = "GT2 2 mm";
    summary = "The belt profile, which settles the pulleys with it";
}

// --- what is bought ---------------------------------------------------------
// The beam follows the travel and never the other way round. 100 is the
// carriage's own length plus a little, and it is written here rather than
// inside the carriage because it is a property of putting the two together.

stock beam  = <extrusions/t-slot-extrusion>(extrusion=profile, length=travel + 150);
stock motor = <motors/nema-motor>(frame=frame, body_length=48, shaft_length=24);

// No T-nuts. The first version bolted brackets into the beam's slots and needed
// eight of them; the flange hub bolts to a bolt circle instead, and the only
// thing touching a slot now is the carriage, which rides it rather than being
// fixed to it. A stock line nothing consumes is a stock line to delete.

// --- what is made -----------------------------------------------------------
// Three of these mechanica has. Three it does not, and they are marked: an
// idler L bracket that mirrors the NEMA one, and the carriage and clamp that
// ride the beam. PARTS-WANTED.md carries the asks.

part motor_flange = <extrusions/end-flange>(extrusion=profile, flange_size=60, flange_thickness=6,
                                            socket_depth=25, holes=4, hole_circle=44, hole=3.4);
part idler_flange = <extrusions/end-flange>(extrusion=profile, flange_size=60, flange_thickness=6,
                                            socket_depth=25, holes=4, hole_circle=44, hole=3.4);

part motor_bracket = <brackets/nema-l-bracket>(frame=frame, holes=4, hole_circle=44, hole=3.4,
                                               width=60, flange_leg=60, motor_leg=50);
part idler_bracket = <brackets/idler-l-bracket>(holes=4, hole_circle=44, hole=3.4,
                                                width=60, flange_leg=60, spindle_leg=50,
                                                spindle=5, spindle_length=24);   // TODO(mechanica)

part drive_pulley = <pulleys/timing-pulley>(profile=belt_profile, teeth=20, bore=5);
part idler_pulley = <pulleys/timing-pulley>(profile=belt_profile, teeth=20, bore=5);
part idler_bush   = <bushings/flanged-bushing>(bore=5, outer_diameter=8, length=7);

part carriage = <carriages/belt-carriage>(profile=profile, length=60, height=8);   // TODO(mechanica)
// Two numbers here are settled by the belt rather than chosen. reach is the
// pitch radius, because the runs are one radius either side of the pulley axis.
// groove is how far the grip line stands off the carriage, and it has to reach
// the PITCH circle's plane - which is 5.5 mm into the pulley from its bore
// face, not flush with it. Both were arrived at by fabrica refusing the build
// until they were right, which is what that check is for.
part clamp    = <clamps/belt-clamp>(profile=belt_profile, width=6, grip=12,
                                    spacing=24, groove=9.5, reach=6.365);            // TODO(mechanica)

// --- how it goes together ---------------------------------------------------

ground beam;

// The motor end. The flange swallows the beam's end - the cut end lands on the
// socket floor, which is why the socket anchor is at the flange's thickness and
// not at its mouth.
joint fixed beam.end_a -> motor_flange.socket;

joint fixed motor_flange.flange -> motor_bracket.flange_face {
    fasten = <hardware/cap-screw>(standard="M5", length=16) x4;
}
joint fixed motor_bracket.motor_face -> motor.flange {
    fasten = <hardware/cap-screw>(standard="M3", length=10) x4;
}

// A pulley slides onto a shaft and a grub screw decides where, so the shaft is
// a track and this is a position along it. 8 mm out puts the pitch circle clear
// of the extrusion and on the belt plane.
joint fixed motor.shaft@8 -> drive_pulley.bore {
    fasten = grub;
}

// The idler end, and the same hub doing the same job at the other end.
joint fixed beam.end_b -> idler_flange.socket;

joint fixed idler_flange.flange -> idler_bracket.flange_face {
    fasten = <hardware/cap-screw>(standard="M5", length=16) x4;
}

// 3 rather than the motor's 8, and the difference is the whole lesson. The
// drive pulley hangs off a shaft and the idler sits on a spindle, so the two
// stack in OPPOSITE directions - equal positions put the pitch circles 5 mm
// apart, which is a belt that climbs its flange and shreds. fabrica fails the
// build when they are not coplanar, and this is the number that satisfies it.
joint fixed    idler_bracket.spindle@3 -> idler_bush.bore;
joint revolute idler_bush.outer        -> idler_pulley.bore {
    axis = [0, 0, 1];
}

// The one joint that moves. The track is NOT pinned with @, and that is the
// whole difference: a prismatic joint consumes the freedom a track already has,
// and the limit says how much of it is usable.
// The stroke starts 60 mm in rather than at zero, and that is not tidiness. At
// zero the carriage sits astride the beam's end, which is exactly where the
// motor flange is - and the flange is 60 mm across, so it reaches well into the
// path of anything riding the -x slot. fabrica's clash check reported the
// carriage against three things at once, then against the flange alone, and 60
// is where it stops reporting anything. The beam's extra 150 covers both ends.
joint prismatic beam.slot_x_minus -> carriage.rail_face {
    axis  = [0, 0, 1];
    limit = [60, travel + 60];
    home  = 60;
}

joint fixed carriage.belt_face -> clamp.carriage_face {
    fasten = <hardware/cap-screw>(standard="M3", length=12) x2 into <hardware/hex-nut>(standard="M3");
}

// --- the belt ---------------------------------------------------------------
// Stock, routed through anchors, with its length derived from poses the tree
// already resolved. Not a joint, because a belt closes a loop and the tree rule
// forbids one - and deriving a length from known positions is arithmetic where
// finding positions that satisfy a length would be a solver.
//
// fabrica checks three things about this now, and the third is new because this
// machine needed it: that the pulley axes are parallel, that the pitch circles
// are coplanar, and that the clamped ends actually lie on the run. The first
// two were already here. The third is the one that would have caught the belt
// hanging in space beside a carriage it could not reach.

route belt = <synchronous-belt>(profile=belt_profile) {
    over    = [drive_pulley.pitch_circle, idler_pulley.pitch_circle];
    anchors = [clamp.belt_a, clamp.belt_b];
}

drive motor -> carriage via belt;
